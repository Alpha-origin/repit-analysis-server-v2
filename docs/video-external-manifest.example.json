              "uploadedAt": "2026-10-02T09:00:00+09:00"
            }
          },
          "expected_status": 202,
          "expected": {
            "status": "accepted"
          },
          "save_as": "retry"
        },
        {
          "target": "analysis",
          "path": "/analysis/video/jobs/{retry.jobId}",
          "expected_status": 200,
          "expected": {
            "status": "completed",
            "callbackStatus": "delivered"
          },
