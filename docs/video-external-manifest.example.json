  "scenarios": [
    {
      "name": "valid",
      "steps": [
        {
          "target": "analysis",
          "method": "POST",
          "path": "/analysis/video",
          "body": {
            "requestId": "$run.valid",
            "sessionId": "$run.session",
            "interviewId": "42",
            "userId": "7",
            "callbackUrl": "https://api.example.com/qa/video/callback",
            "video": {
              "videoId": "video-1",
              "fileUrl": "https://example-bucket.s3.ap-northeast-2.amazonaws.com/qa/browser.webm?X-Amz-Signature=REPLACE_VALID",
              "contentType": "video/webm",
              "fileSize": 234567,
              "uploadedAt": "2026-10-02T09:00:00+09:00"
            }
          },
          "expected_status": 202,
          "expected": {
            "status": "accepted"
          },
          "save_as": "valid"
        },
        {
          "target": "analysis",
          "path": "/analysis/video/jobs/{valid.jobId}",
          "expected_status": 200,
          "expected": {
            "status": "completed",
            "callbackStatus": "delivered",
            "result.result.analysis.error.code": "ANALYZER_NOT_CONFIGURED"
          },
          "save_as": "validSnapshot",
          "poll_seconds": 1200
        },
        {
          "target": "receiver",
          "path": "/qa/callbacks/{valid.jobId}",
          "expected_status": 200,
          "poll_seconds": 1200,
          "expected": {
            "body": "$validSnapshot.result",
            "tokenOk": true,
            "attempts": 1
          }
        }
      ]
    },
