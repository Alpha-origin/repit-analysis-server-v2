            "mode": "503-once"
          },
          "expected_status": 200,
          "expected": {
            "mode": "503-once"
          }
        },
        {
          "target": "analysis",
          "method": "POST",
          "path": "/analysis/video",
          "body": {
            "requestId": "$run.callback503",
            "sessionId": "$run.session",
            "interviewId": "42",
            "userId": "7",
            "callbackUrl": "https://api.example.com/qa/video/callback",
