          "path": "/qa/callbacks/{retry.jobId}",
          "expected_status": 200,
          "poll_seconds": 1200,
          "expected": {
            "body": "$retrySnapshot.result",
            "tokenOk": true,
            "attempts": 2,
            "statusCodes": [
              503,
              204
            ]
          },
          "minimum": {
            "retryDelaySeconds": 5
          }
        },
        {
          "target": "receiver",
          "method": "POST",
          "path": "/qa/receiver/mode",
          "body": {
            "mode": "401"
          },
          "expected_status": 200,
          "expected": {
            "mode": "401"
          }
        },
        {
          "target": "analysis",
          "method": "POST",
          "path": "/analysis/video",
          "body": {
            "requestId": "$run.callback401",
            "sessionId": "$run.session",
