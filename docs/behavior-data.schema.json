{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repit/contracts/behavior-data-v1.schema.json",
  "title": "Repit BehaviorData v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "behavior-v1"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "thresholdsVersion": {
      "const": "behavior-policy-v1"
    },
    "videoId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "sampleIntervalMs": {
      "const": 200
    },
    "sampledFrameCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18000
    },
    "sampledDurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "metrics": {
      "type": "object",
      "properties": {
        "faceVisibleRatio": {
          "$ref": "#/$defs/metric"
        },
        "headFacingRatio": {
          "$ref": "#/$defs/metric"
        },
        "shoulderLevelRatio": {
          "$ref": "#/$defs/metric"
        },
        "upperBodyStableRatio": {
          "$ref": "#/$defs/metric"
        },
        "smileShapeRatio": {
          "$ref": "#/$defs/metric"
        }
      },
      "required": [
        "faceVisibleRatio",
        "headFacingRatio",
        "shoulderLevelRatio",
        "upperBodyStableRatio",
        "smileShapeRatio"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/bin"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "eventsTruncated": {
      "type": "boolean"
    },
    "summary": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LOW_SAMPLE_COVERAGE",
          "MULTIPLE_PEOPLE",
          "FACE_TOO_SMALL",
          "LOW_FACE_COVERAGE",
          "LOW_POSE_COVERAGE",
          "COMPONENT_FAILURE",
          "EVENTS_TRUNCATED"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "modelVersion",
    "thresholdsVersion",
    "videoId",
    "durationMs",
    "sampleIntervalMs",
    "sampledFrameCount",
    "sampledDurationMs",
    "metrics",
    "timeline",
    "events",
    "eventsTruncated",
    "summary",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "numeratorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "denominatorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unavailableReason": {
          "enum": [
            null,
            "INSUFFICIENT_DURATION",
            "NO_SINGLE_FACE",
            "HEAD_POSE_UNAVAILABLE",
            "SHOULDERS_NOT_VISIBLE",
            "BLENDSHAPES_UNAVAILABLE",
            "LOW_COVERAGE"
          ]
        }
      },
      "required": [
        "status",
        "value",
        "numeratorMs",
        "denominatorMs",
        "coverageRatio",
        "unavailableReason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "unavailableReason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unavailableReason": {
                "enum": [
                  "INSUFFICIENT_DURATION",
                  "NO_SINGLE_FACE",
                  "HEAD_POSE_UNAVAILABLE",
                  "SHOULDERS_NOT_VISIBLE",
                  "BLENDSHAPES_UNAVAILABLE",
                  "LOW_COVERAGE"
                ]
              }
            }
          }
        }
      ]
    },
    "pair": {
      "type": "object",
      "properties": {
        "numeratorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "denominatorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "required": [
        "numeratorMs",
        "denominatorMs"
      ],
      "additionalProperties": false
    },
    "bin": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "metrics": {
          "type": "object",
          "properties": {
            "faceVisibleRatio": {
              "$ref": "#/$defs/pair"
            },
            "headFacingRatio": {
              "$ref": "#/$defs/pair"
            },
            "shoulderLevelRatio": {
              "$ref": "#/$defs/pair"
            },
            "upperBodyStableRatio": {
              "$ref": "#/$defs/pair"
            },
            "smileShapeRatio": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "faceVisibleRatio",
            "headFacingRatio",
            "shoulderLevelRatio",
            "upperBodyStableRatio",
            "smileShapeRatio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "startMs",
        "endMs",
        "metrics"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "FACE_NOT_VISIBLE",
            "HEAD_TURNED",
            "SHOULDER_TILTED",
            "UPPER_BODY_MOVEMENT"
          ]
        },
        "sourceMetric": {
          "enum": [
            "faceVisibleRatio",
            "headFacingRatio",
            "shoulderLevelRatio",
            "upperBodyStableRatio"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "required": [
        "type",
        "sourceMetric",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Cross-field invariants and ready/partial classification require 01-behavior-contract.md section 11."
}
