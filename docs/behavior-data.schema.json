{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repit/contracts/behavior-data-v1.schema.json",
  "title": "Repit BehaviorData v1",
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "numeratorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "denominatorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unavailableReason": {
          "enum": [
            null,
            "INSUFFICIENT_DURATION",
            "NO_SINGLE_FACE",
            "HEAD_POSE_UNAVAILABLE",
            "SHOULDERS_NOT_VISIBLE",
            "BLENDSHAPES_UNAVAILABLE",
            "LOW_COVERAGE"
          ]
        }
      },
      "required": [
        "status",
        "value",
        "numeratorMs",
        "denominatorMs",
        "coverageRatio",
        "unavailableReason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "unavailableReason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unavailableReason": {
                "enum": [
                  "INSUFFICIENT_DURATION",
                  "NO_SINGLE_FACE",
                  "HEAD_POSE_UNAVAILABLE",
                  "SHOULDERS_NOT_VISIBLE",
                  "BLENDSHAPES_UNAVAILABLE",
                  "LOW_COVERAGE"
                ]
              }
            }
          }
        }
      ]
    },
    "pair": {
      "type": "object",
      "properties": {
        "numeratorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "denominatorMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "required": [
        "numeratorMs",
        "denominatorMs"
      ],
      "additionalProperties": false
    },
    "bin": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "metrics": {
          "type": "object",
          "properties": {
            "faceVisibleRatio": {
              "$ref": "#/$defs/pair"
            },
            "headFacingRatio": {
              "$ref": "#/$defs/pair"
            },
            "shoulderLevelRatio": {
              "$ref": "#/$defs/pair"
            },
            "upperBodyStableRatio": {
              "$ref": "#/$defs/pair"
            },
            "smileShapeRatio": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "faceVisibleRatio",
            "headFacingRatio",
            "shoulderLevelRatio",
            "upperBodyStableRatio",
            "smileShapeRatio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "startMs",
        "endMs",
        "metrics"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "FACE_NOT_VISIBLE",
            "HEAD_TURNED",
            "SHOULDER_TILTED",
            "UPPER_BODY_MOVEMENT"
          ]
        },
        "sourceMetric": {
          "enum": [
            "faceVisibleRatio",
            "headFacingRatio",
            "shoulderLevelRatio",
            "upperBodyStableRatio"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "required": [
        "type",
        "sourceMetric",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    }
  }
}
