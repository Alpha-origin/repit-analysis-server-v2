global:
  scrape_interval: 30s
rule_files:
  - /etc/prometheus/repit-video-alerts.yml
scrape_configs:
  - job_name: repit-video
    scheme: https
    metrics_path: /internal/video/metrics
    follow_redirects: false
    http_headers:
      X-Internal-Token:
        files:
          - /etc/prometheus/secrets/repit-video-api-token
    static_configs:
      - targets:
          - analysis.internal.example.com:443
