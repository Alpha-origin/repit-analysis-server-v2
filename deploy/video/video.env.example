# Install as /etc/repit/video.env, root-owned mode 0600. Replace hosts and blank secrets.
APP_ENVIRONMENT=production
ANTHROPIC_API_KEY=
APP_INTERNAL_CALLBACK_TOKEN=
APP_CALLBACK_ALLOWED_HOSTS=api.example.com
APP_CALLBACK_BLOCKED_HOSTS=
VIDEO_ENABLED=true
VIDEO_METRICS_ENABLED=true
VIDEO_API_TOKEN=
VIDEO_DATABASE_PATH=/srv/repit/video/jobs.sqlite3
VIDEO_ARTIFACT_ROOT=/srv/repit/video/artifacts
VIDEO_POLICY__SOURCE_HOSTS=["example-bucket.s3.ap-northeast-2.amazonaws.com"]
VIDEO_BLOCKED_SOURCE_HOSTS=
VIDEO_IO_CONCURRENCY=2
VIDEO_CPU_CONCURRENCY=1
VIDEO_CALLBACK_CONCURRENCY=1
VIDEO_DISK_BUDGET_BYTES=21474836480
VIDEO_POLICY__MIN_FREE_DISK_BYTES=2147483648
VIDEO_POLICY__ANALYZE_TIMEOUT_SECONDS=900
VIDEO_ANALYZER__BACKEND=unconfigured
